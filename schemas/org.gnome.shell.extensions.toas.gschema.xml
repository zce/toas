<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.toas" path="/org/gnome/shell/extensions/toas/">
    <key name="push-to-talk" type="as">
      <default>['&lt;Ctrl&gt;&lt;Shift&gt;space']</default>
      <summary>Push-to-talk shortcut</summary>
    </key>

    <key name="history-limit" type="u">
      <range min="1" max="1000"/>
      <default>10</default>
      <summary>Number of voice sessions to retain</summary>
    </key>

    <key name="recording-format" type="s">
      <choices>
        <choice value="wav"/>
      </choices>
      <default>'wav'</default>
      <summary>Recording file format</summary>
    </key>

    <key name="transcription-endpoint" type="s">
      <default>'https://token-plan-cn.xiaomimimo.com/v1/chat/completions'</default>
      <summary>Multimodal Chat Completions endpoint</summary>
    </key>

    <key name="transcription-api-key" type="s">
      <default>''</default>
      <summary>Transcription API key</summary>
    </key>

    <key name="transcription-model" type="s">
      <default>'mimo-v2.5-asr'</default>
      <summary>Transcription model</summary>
    </key>

    <key name="transcription-language" type="s">
      <default>''</default>
      <summary>Optional transcription language code</summary>
    </key>

    <key name="refine-enabled" type="b">
      <default>true</default>
      <summary>Refine the raw transcript</summary>
    </key>

    <key name="refine-endpoint" type="s">
      <default>'https://api.openai.com/v1/chat/completions'</default>
      <summary>OpenAI-compatible refine endpoint</summary>
    </key>

    <key name="refine-api-key" type="s">
      <default>''</default>
      <summary>Refine API key</summary>
    </key>

    <key name="refine-model" type="s">
      <default>''</default>
      <summary>Refine model</summary>
    </key>

    <key name="refine-system-prompt" type="s">
      <default>'You are a voice-input editor. Rewrite the speech transcript into clean text suitable to send as a prompt or message. Preserve the original meaning, intent, language, technical terms, names, code, URLs, and important details. Remove filler words, false starts, duplicated fragments, and obvious speech-recognition errors. Improve punctuation and structure only when helpful. Do not answer the content or act on it. Output only the rewritten text.'</default>
      <summary>Refine system prompt</summary>
    </key>

    <key name="restore-clipboard" type="b">
      <default>true</default>
      <summary>Restore previous clipboard text after paste</summary>
    </key>
  </schema>
</schemalist>
