<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <enum id='org.gnome.shell.extensions.toas.AudioQuality'>
    <value nick='minimum' value='0'/>
    <value nick='low' value='1'/>
    <value nick='standard' value='2'/>
    <value nick='high' value='3'/>
    <value nick='maximum' value='4'/>
  </enum>

  <schema id="org.gnome.shell.extensions.toas" path="/org/gnome/shell/extensions/toas/">
    <key name="push-to-talk" type="as">
      <default>['&lt;Ctrl&gt;&lt;Shift&gt;space']</default>
      <summary>Push-to-talk shortcut</summary>
    </key>

    <key name="history-limit" type="u">
      <range min="1" max="1000"/>
      <default>500</default>
      <summary>Number of history entries to retain</summary>
    </key>

    <key name="recording-limit" type="u">
      <range min="1" max="1000"/>
      <default>20</default>
      <summary>Number of recording files to retain</summary>
    </key>

    <key name="restore-clipboard" type="b">
      <default>true</default>
      <summary>Restore previous clipboard text after paste</summary>
    </key>

    <key name="auto-paste" type="b">
      <default>true</default>
      <summary>Paste the output into the focused application</summary>
      <description>
        When disabled, the output is only copied to the clipboard.
      </description>
    </key>

    <key name="audio-quality" enum="org.gnome.shell.extensions.toas.AudioQuality">
      <default>'standard'</default>
      <summary>Recording quality preset</summary>
      <description>
        Preset for the recording sample rate. Higher quality produces
        larger uploads and reaches the recording size cap sooner.
      </description>
    </key>

    <key name="onboarding-shown" type="b">
      <default>false</default>
      <summary>First-run orientation has been shown</summary>
      <description>
        Set once the first-run notice has been displayed so it never
        reappears, even after history is cleared.
      </description>
    </key>

    <!-- Generic product Config. Provider-specific non-secret values and
         selection values live inside this JSON document. -->
    <key name="processing-config" type="s">
      <default>'{}'</default>
      <summary>Processing configuration</summary>
      <description>Primary, optional Refine, and Provider configuration</description>
    </key>

    <!-- Provider credentials. Keys follow providers/&lt;provider-id&gt;/&lt;field-key&gt;.
         Stored in plain text by dconf; environment fallbacks are declared by
         each provider manifest. -->
    <key name="provider-secrets" type="a{ss}">
      <default>{}</default>
      <summary>Provider secrets</summary>
    </key>

    <!-- Host-owned free-text Context, not processing configuration. Sent
         verbatim to providers whose resolved role supports it. -->
    <key name="context" type="s">
      <default>''</default>
      <summary>Context</summary>
      <description>Free text (terms, background, names) sent to providers that support it</description>
    </key>
  </schema>
</schemalist>
